package views

// ServicesPage lists what the workshop does. Draft copy limited to confirmed
// facts. Extend once the owner confirms the additional services offered.
templ ServicesPage(l Layout) {
	@Base(l) {
		<section class="page">
			<h1>What we do</h1>
			<p class="page-lede">
				We are Hino and Hilux specialists. We work on the light-duty Hino 300
				and the heavy-duty Hino 700, as well as the Toyota Hilux. Whether it is
				a single bakkie or a whole fleet, you get the same specialist care and
				honest advice.
			</p>
			<ul class="services">
				<li>
					<h2>Servicing &amp; maintenance</h2>
					<p>Keeping your Hino trucks and Hilux bakkies reliable and on the road.</p>
				</li>
				<li>
					<h2>Repairs</h2>
					<p>Specialist repair work by people who know these vehicles inside out.</p>
				</li>
				<li>
					<h2>Fleet servicing</h2>
					<p>Planned maintenance built around how and when your fleet works.</p>
				</li>
				<li>
					<h2>Fast, honest turnaround</h2>
					<p>Downtime costs money, so we get you back to work quickly, and tell you straight what needs doing.</p>
				</li>
			</ul>
		</section>
	}
}
