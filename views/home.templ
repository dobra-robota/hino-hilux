package views

// HomePage is the full home page: shell + home body.
templ HomePage(l Layout) {
	@Base(l) {
		@homeBody(l)
	}
}

templ homeBody(l Layout) {
	<section class="hero">
		<div class="hero-inner">
			<p class="eyebrow">A family-run Hino &amp; Hilux workshop</p>
			<h1>A father, two sons, and fifty years under the&nbsp;bonnet.</h1>
			<p class="lede">
				We're a family workshop that lives and breathes Hino trucks and Hilux
				bakkies — from the light-duty Hino 300 to the heavy-duty Hino 700. When
				your vehicle is off the road your business is too, so we get you back to
				work fast, and we tell you straight what needs doing.
			</p>
			<p class="cta-pending">Phone &amp; online booking &mdash; coming soon.</p>
		</div>
	</section>
	<section class="value-props">
		<article>
			<h2>Fifty years between us</h2>
			<p>
				A dad and his two sons, with more than fifty years of combined experience
				keeping Hino trucks and Hilux bakkies running.
			</p>
		</article>
		<article>
			<h2>Trusted by big fleets</h2>
			<p>
				Major fleet operators count on us to keep their vehicles moving — and
				every customer, big or small, gets the same care.
			</p>
		</article>
		<article>
			<h2>Back on the road, fast</h2>
			<p>
				We know downtime costs money. Quick, honest turnaround is the whole
				point of what we do.
			</p>
		</article>
	</section>
}
