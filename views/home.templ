package views

// HomePage is the full home page: shell + home body.
templ HomePage(l Layout) {
	@Base(l) {
		@homeBody(l)
	}
}

templ homeBody(l Layout) {
	<section class="hero">
		<div class="hero-inner">
			<p class="eyebrow">A family-run Hino &amp; Hilux workshop for Gauteng fleets</p>
			<h1>A father, two sons, and fifty years under the&nbsp;bonnet.</h1>
			<p class="lede">
				We're a family workshop that lives and breathes Hino trucks and Hilux
				bakkies: the light-duty Hino 300, the medium-duty Hino 500, the
				heavy-duty Hino 700, and the Toyota Hilux in D4D 2.5, D4D 3.0,
				GD6 2.4 and GD6 2.8. We look after Gauteng fleets of five to a
				hundred vehicles, and when one is off the road the business behind it
				is too, so we get it back to work fast and tell you straight what
				needs doing.
			</p>
			<p class="cta-pending">Ask us for your fleet rate &mdash; phone &amp; online booking coming soon.</p>
		</div>
	</section>
	<section class="value-props">
		<article>
			<h2>You speak to the owners</h2>
			<p>
				No service desk, no reference number, no call back tomorrow. You talk
				to the people who own the workshop and you get an answer there and
				then.
			</p>
		</article>
		<article>
			<h2>We find the fault first</h2>
			<p>
				We work out what is actually wrong before we replace anything, so you
				are not paying twice for a repair made on a guess.
			</p>
		</article>
		<article>
			<h2>Trusted by fleets like Fidelity</h2>
			<p>
				Fleets like Fidelity count on us to keep their vehicles moving. Fleet
				maintenance is all we do, so the work is planned around how your
				operation runs.
			</p>
		</article>
		<article>
			<h2>We get the vehicle in</h2>
			<p>
				If a vehicle goes down before 17:00 we call in the breakdown operator
				we work with to fetch it. If your fleet runs its own recovery, bring
				it straight to us.
			</p>
		</article>
	</section>
}
